# AlEx AI Platform v3 — exemplo de configuração
# Copie para .env e preencha com seus valores (nunca commite o .env real)

PORT=8080

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Google OAuth (obrigatório p/ login Google — obtenha no Google Cloud Console)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# E-mail(s) do administrador (separados por vírgula)
# Usado para autorizar o botão de shutdown na interface web
ADMIN_EMAILS=seu-email@gmail.com

# Opcional — túnel público
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
