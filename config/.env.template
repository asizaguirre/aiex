# ============================================
# AlEx AI Platform v3 - Unified Configuration
# ============================================
# Copy this file to .env and fill in the values.
# This is the SINGLE source of truth for all config.
# NEVER commit the real .env with secrets.

# ─── Application ──────────────────────────────
PORT=8080
ADMIN_EMAILS=seu-email@gmail.com
USER_DB_PATH=db/users.json

# ─── Google OAuth ─────────────────────────────
# Obtenha em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ─── Ollama ───────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
RAG_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBEDDING_MODEL=nomic-embed-text

# ─── ngrok (Public Tunnel) ────────────────────
# Preencha localmente no .env — nunca commite tokens reais
NGROK_AUTHTOKEN=
NGROK_API_KEY=
NGROK_DOMAIN=

# ─── ChromaDB ─────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ─── Elasticsearch (ELK) ─────────────────────
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_DISCOVERY_TYPE=single-node

# ─── Java ─────────────────────────────────────
JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
